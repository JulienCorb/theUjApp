# Node
TZ=UTC
PORT=3333
HOST=localhost
# development = local only; never expose publicly. Every deployed environment
# (staging/preview/prod) MUST use NODE_ENV=production — otherwise the exception
# handler returns verbose error pages (app/exceptions/handler.ts) leaking stack
# traces. Label the stage separately, e.g. APP_ENV=staging.
NODE_ENV=development

# App
LOG_LEVEL=info
APP_NAME=myappname
APP_KEY=
APP_URL=http://${HOST}:${PORT}
WEB_APP_URL=http://localhost:3000

# Password reset
# REQUIRED HMAC secret used to hash password reset tokens (no APP_KEY fallback).
# Rotating it invalidates all outstanding password reset links.
PASSWORD_RESET_SECRET=
# Validity window of a password reset link in minutes (default 60).
PASSWORD_RESET_TTL_MINUTES=60

# Invitations
# REQUIRED HMAC secret used to hash invitation tokens (no APP_KEY fallback).
# Rotating it invalidates all outstanding invitation links.
INVITATION_SECRET=
# Validity window of an invitation link in days (default 7).
INVITATION_TTL_DAYS=7

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=the_uj_app_dev


#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
MAIL_MAILER=resend
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
RESEND_API_KEY=your-resend-api-key
