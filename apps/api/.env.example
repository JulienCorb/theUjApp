# Node
TZ=UTC
PORT=3333
HOST=localhost
# development = local only; never expose publicly. Every deployed environment
# (staging/preview/prod) MUST use NODE_ENV=production — otherwise the exception
# handler returns verbose error pages (app/exceptions/handler.ts) leaking stack
# traces. Label the stage separately, e.g. APP_ENV=staging.
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=the_uj_app_dev


#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000